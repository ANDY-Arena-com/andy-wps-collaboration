{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andy-arena.com/schema/andy.behavior-card/1.0-draft",
  "title": "ANDY Behavior Card Export 1.0-draft",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "subject",
    "snapshot",
    "scope",
    "metrics",
    "speed_observations",
    "matches",
    "conditions",
    "interpretations",
    "provenance",
    "publication",
    "links",
    "quality"
  ],
  "properties": {
    "schema": {
      "const": "andy.behavior-card"
    },
    "schema_version": {
      "const": "1.0-draft"
    },
    "subject": {
      "type": "object",
      "required": [
        "model_label",
        "provider_label",
        "model_api_id",
        "identity_status"
      ],
      "properties": {
        "model_label": {
          "type": "string",
          "minLength": 1
        },
        "provider_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_api_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_status": {
          "type": "string"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "snapshot_id",
        "metric_registry_version",
        "type"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_data_as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "exporter_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "metric_registry_version": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "selection",
        "logical_match_count",
        "model_appearances"
      ],
      "properties": {
        "selection": {
          "type": "string"
        },
        "logical_match_count": {
          "type": "integer",
          "minimum": 0
        },
        "model_appearances": {
          "type": "integer",
          "minimum": 0
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metric"
      }
    },
    "speed_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match_id",
          "own_api_seconds",
          "coverage_status"
        ],
        "properties": {
          "match_id": {
            "type": "string"
          },
          "own_api_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "coverage_status": {
            "type": "string"
          }
        }
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match_id",
          "role",
          "api_decisions",
          "executed_actions"
        ],
        "properties": {
          "match_id": {
            "type": "string"
          },
          "series_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "white",
              "black"
            ]
          },
          "api_decisions": {
            "type": "integer",
            "minimum": 0
          },
          "executed_actions": {
            "type": "integer",
            "minimum": 0
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "ruleset_version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "status",
          "source_refs"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "status": {
            "enum": [
              "BEOBACHTET",
              "BERECHNET",
              "INTERPRETIERT",
              "OFFEN"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_kind",
        "source_refs"
      ]
    },
    "publication": {
      "type": "object",
      "required": [
        "status",
        "approved"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "review",
            "approved",
            "published"
          ]
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "links": {
      "type": "object"
    },
    "quality": {
      "type": "object"
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "status",
        "metric_version",
        "coverage",
        "source_ids"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "status": {
          "enum": [
            "BEOBACHTET",
            "BERECHNET",
            "INTERPRETIERT",
            "OFFEN"
          ]
        },
        "metric_version": {
          "type": "string"
        },
        "coverage": {
          "type": "object",
          "required": [
            "covered_matches",
            "total_matches"
          ],
          "properties": {
            "covered_matches": {
              "type": "integer",
              "minimum": 0
            },
            "total_matches": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
